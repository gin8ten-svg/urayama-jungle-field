# ===== API キー =====
# Google Maps Platform で Places API (New) を有効化して発行
GOOGLE_MAPS_API_KEY=
# 無料枠（各SKU 月1,000回）を超えないための上限。これに達するとその月は自動で止まる
PLACES_SEARCH_MONTHLY_LIMIT=900
PLACES_DETAILS_MONTHLY_LIMIT=900
# Claude API（有料）。空欄なら「無料モード」：briefs.json を Claude Code に書いてもらう
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ===== 送信者情報（特定電子メール法で表示義務あり。必須） =====
SENDER_NAME=山田太郎
SENDER_COMPANY=ヤマダWeb制作
SENDER_ADDRESS=埼玉県さいたま市〇〇区〇〇1-2-3
SENDER_PHONE=090-0000-0000
SENDER_EMAIL=you@example.com
# 配信停止の受付アドレス（未設定なら SENDER_EMAIL）
OPTOUT_EMAIL=

# ===== 料金（メール本文に入ります） =====
PRICE_INITIAL=29,800円（税込）
PRICE_MONTHLY=月額 980円（サーバー・ドメイン・軽微な更新込み）

# ===== メール送信（Gmail の場合はアプリパスワード） =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=
DAILY_SEND_LIMIT=20
SEND_INTERVAL_SEC=60

# ===== サンプルサイトの公開先（どちらか） =====
# Netlify の Personal access token
NETLIFY_TOKEN=
# 自分で output/sites を公開している場合のベースURL
PREVIEW_BASE_URL=
