<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ shop.name }}{% if shop.category %}｜{{ shop.category }}{% endif %}</title>
<meta name="description" content="{{ c.meta_description }}">
{% if preview %}<meta name="robots" content="noindex, nofollow">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root { {{ palette }} }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Noto Sans JP", sans-serif; color: var(--ink); background: var(--bg); line-height: 1.9; }
  a { color: inherit; }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
  .preview-bar { background: #222; color: #fff; font-size: 13px; text-align: center; padding: 8px 16px; position: sticky; top: 0; z-index: 10; }
  header.site { display: flex; justify-content: space-between; align-items: center; padding: 18px 0; }
  header.site .logo { font-family: "Noto Serif JP", serif; font-weight: 700; font-size: 20px; }
  header.site nav a { margin-left: 18px; font-size: 14px; text-decoration: none; opacity: .8; }
  .hero { background: linear-gradient(135deg, var(--main), var(--accent)); color: #fff; padding: 110px 0 120px; position: relative; overflow: hidden; }
  .hero .emoji { position: absolute; right: 6%; bottom: -20px; font-size: 220px; opacity: .18; line-height: 1; }
  .hero h1 { font-family: "Noto Serif JP", serif; font-size: clamp(30px, 6vw, 54px); line-height: 1.35; letter-spacing: .04em; }
  .hero p { margin-top: 20px; max-width: 560px; font-size: 16px; opacity: .95; }
  .hero .badge { display: inline-flex; gap: 8px; align-items: center; margin-top: 28px; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.35); padding: 8px 16px; border-radius: 999px; font-size: 14px; text-decoration: none; }
  .btn { display: inline-block; margin-top: 28px; margin-left: 8px; background: #fff; color: var(--main); padding: 12px 26px; border-radius: 999px; font-weight: 700; text-decoration: none; }
  section { padding: 84px 0; }
  section.alt { background: var(--soft); }
  h2 { font-family: "Noto Serif JP", serif; font-size: 28px; margin-bottom: 32px; text-align: center; }
  h2 small { display: block; font-family: "Noto Sans JP"; font-size: 12px; letter-spacing: .3em; color: var(--main); margin-bottom: 6px; }
  .about p { max-width: 720px; margin: 0 auto; white-space: pre-line; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 22px; }
  .card { background: var(--card); border-radius: 16px; padding: 28px; box-shadow: 0 6px 24px rgba(0,0,0,.06); }
  .card .num { font-family: "Noto Serif JP", serif; color: var(--main); font-size: 30px; line-height: 1; }
  .card h3 { font-size: 18px; margin: 12px 0 8px; }
  .scenes { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .scenes span { background: var(--card); border: 1px solid var(--main); color: var(--main); padding: 8px 20px; border-radius: 999px; font-weight: 700; }
  .info { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
  .info dl { display: grid; grid-template-columns: 6em 1fr; gap: 12px 16px; }
  .info dt { font-weight: 700; color: var(--main); }
  .info dd ul { list-style: none; }
  .map iframe { width: 100%; height: 340px; border: 0; border-radius: 16px; }
  footer { background: var(--ink); color: #fff; text-align: center; padding: 32px 0; font-size: 13px; }
  .tel-fab { position: fixed; right: 16px; bottom: 16px; background: var(--main); color: #fff; padding: 14px 20px; border-radius: 999px; font-weight: 700; text-decoration: none; box-shadow: 0 8px 24px rgba(0,0,0,.2); display: none; }
  @media (max-width: 720px) {
    header.site nav { display: none; }
    .hero { padding: 80px 0 90px; }
    .info { grid-template-columns: 1fr; }
    .tel-fab { display: inline-block; }
  }
</style>
</head>
<body>
{% if preview %}
<div class="preview-bar">これは {{ shop.name }} 様へのご提案用サンプルページです（お店の公式サイトではありません）</div>
{% endif %}
<div class="wrap">
  <header class="site">
    <div class="logo">{{ shop.name }}</div>
    <nav><a href="#about">お店について</a>{% if c.recommended %}<a href="#menu">おすすめ</a>{% endif %}<a href="#info">店舗情報</a></nav>
  </header>
</div>

<div class="hero">
  <div class="emoji" aria-hidden="true">{{ c.hero_emoji }}</div>
  <div class="wrap">
    <h1>{{ c.catchcopy }}</h1>
    <p>{{ c.lead }}</p>
    {% if shop.rating %}
    <a class="badge" href="{{ shop.maps_url }}" target="_blank" rel="noopener">★ {{ "%.1f"|format(shop.rating) }}　Googleの口コミ {{ shop.review_count }}件</a>
    {% endif %}
    {% if shop.phone %}<a class="btn" href="tel:{{ shop.phone|replace('-', '') }}">お電話はこちら</a>{% endif %}
  </div>
</div>

<section id="about" class="about">
  <div class="wrap">
    <h2><small>ABOUT</small>{{ shop.name }}について</h2>
    <p>{{ c.about }}</p>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <h2><small>FEATURES</small>選ばれる理由</h2>
    <div class="grid">
      {% for f in c.features %}
      <div class="card"><div class="num">0{{ loop.index }}</div><h3>{{ f.title }}</h3><p>{{ f.text }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

{% if c.recommended %}
<section id="menu">
  <div class="wrap">
    <h2><small>RECOMMEND</small>人気のメニュー</h2>
    <div class="grid">
      {% for m in c.recommended %}
      <div class="card"><h3>{{ m.name }}</h3><p>{{ m.text }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="alt">
  <div class="wrap">
    <h2><small>SCENE</small>こんなときに</h2>
    <div class="scenes">{% for s in c.scenes %}<span>{{ s }}</span>{% endfor %}</div>
  </div>
</section>

<section id="info">
  <div class="wrap">
    <h2><small>INFORMATION</small>店舗情報</h2>
    <div class="info">
      <dl>
        <dt>店名</dt><dd>{{ shop.name }}</dd>
        {% if shop.category %}<dt>業種</dt><dd>{{ shop.category }}</dd>{% endif %}
        <dt>住所</dt><dd>{{ shop.address }}</dd>
        {% if shop.phone %}<dt>電話</dt><dd><a href="tel:{{ shop.phone|replace('-', '') }}">{{ shop.phone }}</a></dd>{% endif %}
        {% if hours %}<dt>営業時間</dt><dd><ul>{% for h in hours %}<li>{{ h }}</li>{% endfor %}</ul></dd>{% endif %}
        {% if shop.maps_url %}<dt>地図</dt><dd><a href="{{ shop.maps_url }}" target="_blank" rel="noopener">Googleマップで開く</a></dd>{% endif %}
      </dl>
      <div class="map">
        <iframe loading="lazy" title="地図" src="https://maps.google.com/maps?q={{ map_query|urlencode }}&hl=ja&z=16&output=embed"></iframe>
      </div>
    </div>
  </div>
</section>

<footer>&copy; {{ year }} {{ shop.name }}</footer>
{% if shop.phone %}<a class="tel-fab" href="tel:{{ shop.phone|replace('-', '') }}">📞 電話する</a>{% endif %}
</body>
</html>
